# ====== Telegram ======
BOT_API_TOKEN=your_bot_api_token_here
# Comma-separated Telegram user IDs of admins. Admins always have access and approve
# everyone else. Message the bot once: it replies with your ID.
ADMIN_IDS=

# ====== Uploads above 50 MB (optional) ======
# The cloud Bot API caps uploads at 50 MB. To go up to 2000 MB, either:
#
# a) Upload big files with Telethon, logged in as the bot.
#    App credentials come from https://my.telegram.org
API_ID=
API_HASH=
#
# b) Run a local Bot API server (also needs API_ID/API_HASH above).
#    See the README before switching: the bot must log out of the cloud API first.
#COMPOSE_PROFILES=local-bot-api
#LOCAL_BOT_API_URL=http://telegram-bot-api:8081
#
# With neither, files above 50 MB are refused.

# ====== Downloads ======
# Netscape-format YouTube cookies, placed in ./secrets/ (mounted read-only)
COOKIES_FILE=/app/secrets/cookies.txt
MAX_PARALLEL_DOWNLOADS=2
MAX_DURATION_MINUTES=180

LOG_LEVEL=INFO
